---
import "../styles/global.css";
import "../styles/content.css";

import { ClientRouter } from "astro:transitions";
import Navigation from "./Navigation.astro";

const { title, primaryTag } = Astro.props;

const SITE_URL = "https://marnixvanso.om";
const SITE_NAME = "Marnix Van Soom";
const SITE_DESCRIPTION =
  "Personal R&D blog of Marnix Van Soom, covering probabilistic machine learning, software development, media art, and related notes.";
const PERSON_DESCRIPTION =
  "Marnix Van Soom is a researcher and developer working between probabilistic machine learning, software development, and media art.";
const PERSON_ID = `${SITE_URL}/about/#person`;
const WEBSITE_ID = `${SITE_URL}/#website`;
const DEFAULT_KEYWORDS = [
  "Marnix Van Soom",
  "probabilistic machine learning",
  "software development",
  "media art",
  "Bayesian inference",
  "Gaussian processes",
  "signal processing",
  "Alexander Technique",
  "music",
].join(", ");

const pageTitle =
  typeof title === "string" && title.trim() !== "" ? title.trim() : SITE_NAME;

const {
  canonical = `${SITE_URL}${Astro.url.pathname}`,
  description,
  keywords = DEFAULT_KEYWORDS,
} = Astro.props;

const isProfilePage =
  canonical === `${SITE_URL}/` ||
  canonical === `${SITE_URL}/about` ||
  canonical === `${SITE_URL}/about/`;
const pageDescription =
  description ?? (isProfilePage ? PERSON_DESCRIPTION : SITE_DESCRIPTION);
const ogType = isProfilePage ? "profile" : "website";

const structuredData = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "@id": WEBSITE_ID,
      url: `${SITE_URL}/`,
      name: SITE_NAME,
      alternateName: "marnixvanso.om",
      description: SITE_DESCRIPTION,
      author: { "@id": PERSON_ID },
      publisher: { "@id": PERSON_ID },
      inLanguage: "en",
    },
    {
      "@type": "Person",
      "@id": PERSON_ID,
      name: SITE_NAME,
      url: `${SITE_URL}/about/`,
      email: "info@marnixvanso.om",
      jobTitle: "Researcher and developer",
      description: PERSON_DESCRIPTION,
      affiliation: [
        {
          "@type": "Organization",
          name: "AI Lab, Vrije Universiteit Brussel",
          url: "https://ai.vub.ac.be/",
        },
        {
          "@type": "Organization",
          name: "Industrial Vision Lab, University of Antwerp",
          url: "https://invilab.be/",
        },
      ],
      knowsAbout: [
        "probabilistic machine learning",
        "Bayesian inference",
        "Gaussian processes",
        "software development",
        "media art",
        "signal processing",
        "network theory",
        "Alexander Technique",
        "music",
      ],
      sameAs: [
        "https://orcid.org/0000-0002-1935-1770",
        "https://researchportal.vub.be/en/persons/marnix-van-soom",
      ],
    },
    {
      "@type": "WebPage",
      "@id": `${canonical}#webpage`,
      url: canonical,
      name: pageTitle,
      description: pageDescription,
      isPartOf: { "@id": WEBSITE_ID },
      author: { "@id": PERSON_ID },
      ...(isProfilePage ? { about: { "@id": PERSON_ID } } : {}),
      inLanguage: "en",
    },
  ],
};

---

<html lang="en">
  <head>
    <meta charset="UTF-8" />

    <link rel="canonical" href={canonical} />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={keywords} />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={SITE_NAME} />
    <meta name="robots" content="index, follow" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    {
      isProfilePage && (
        <>
          <meta property="profile:first_name" content="Marnix" />
          <meta property="profile:last_name" content="Van Soom" />
          <link rel="me" href="https://orcid.org/0000-0002-1935-1770" />
          <link
            rel="me"
            href="https://researchportal.vub.be/en/persons/marnix-van-soom"
          />
        </>
      )
    }

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />

    <!-- Fixes glitch on iOS: https://stackoverflow.com/a/6138970/6783015 -->
    <meta
      name="viewport"
      content="initial-scale=1.0, maximum-scale=1.0, minimum-scale=1.0, user-scalable=no, width=device-width"
    />

    <meta name="format-detection" content="telephone=no" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    
    <title>{pageTitle}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
    <ClientRouter />
    <script>
      const registryKey = "__titleTransitionsReady";

      if (!window[registryKey]) {
        window[registryKey] = true;

        const postAttribute = "data-post-title-transition";
        const navAttribute = "data-nav-title-transition";
        let activeId = null;
        let activeName = null;
        let activeSource = null;

        function clearSource() {
          if (activeSource) {
            activeSource.style.viewTransitionName = "";
            activeSource = null;
          }
        }

        function getTitleTransitionLink(event) {
          const target = event.composedPath?.()[0] ?? event.target;
          if (!(target instanceof Element)) return null;
          return target.closest(`a[${postAttribute}], a[${navAttribute}]`);
        }

        function getTransitionName(id) {
          return `post-title-${id.replace(/[^a-zA-Z0-9_-]/g, "-")}`;
        }

        function getTitleTransition(link) {
          const postId = link.getAttribute(postAttribute);
          if (postId) {
            return {
              id: postId,
              name: getTransitionName(postId),
              source: link,
            };
          }

          const navId = link.getAttribute(navAttribute);
          if (navId) {
            return {
              id: navId,
              name: "nav-title",
              source: link.querySelector(".monospan") ?? link,
            };
          }

          return null;
        }

        document.addEventListener(
          "click",
          (event) => {
            if (
              event.button !== 0 ||
              event.metaKey ||
              event.ctrlKey ||
              event.altKey ||
              event.shiftKey ||
              event.defaultPrevented
            ) {
              return;
            }

            const link = getTitleTransitionLink(event);
            if (!link) return;

            const target = link.getAttribute("target");
            if ((target && target !== "_self") || link.origin !== location.origin) {
              return;
            }

            const transition = getTitleTransition(link);
            if (!transition) return;

            clearSource();
            activeId = transition.id;
            activeName = transition.name;
            activeSource = transition.source;
            activeSource.style.viewTransitionName = activeName;

            window.setTimeout(() => {
              if (activeSource === transition.source) clearSource();
            }, 4000);
          },
          { capture: true },
        );

        document.addEventListener("astro:before-swap", (event) => {
          if (!activeId || !activeName || !event.newDocument) return;

          const heading = Array.from(
            event.newDocument.querySelectorAll("article.content > h1[id]"),
          ).find((element) => element.id === activeId);

          if (!heading) return;
          heading.style.viewTransitionName = activeName;

          event.viewTransition?.finished?.finally(() => {
            heading.style.viewTransitionName = "";
          });
        });

        document.addEventListener("astro:page-load", () => {
          activeId = null;
          activeName = null;
          activeSource = null;
        });
      }
    </script>
  </head>
  <body>
    <nav class="ongrid">
      <div class="bleed">
        <Navigation class="bleed" selectedTag={primaryTag} />
      </div>
    </nav>

    <main>
      <article class="ongrid content">
        <slot />
      </article>
    </main>
  </body>
</html>
